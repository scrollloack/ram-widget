import { Palette } from "std-widgets.slint";

export component Main inherits Window {
    in property <string> text: "0.0/0.0 GB";
    in property <int> percent: 0;
    callback drag(length, length);

    width: 170px;
    height: 36px;
    no-frame: true;
    always-on-top: true;
    title: "RAM";
    background: Palette.background;

    Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: Palette.border;

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 7px;
            spacing: 4px;

            HorizontalLayout {
                Text {
                    text: root.text;
                    font-size: 14px;
                    color: Palette.foreground;
                    vertical-alignment: center;
                }
                Text {
                    text: root.percent + "%";
                    font-size: 14px;
                    font-weight: 600;
                    color: Palette.foreground;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 3px;
                border-radius: 1.5px;
                background: Palette.alternate-background;
                Rectangle {
                    x: 0;
                    width: parent.width * root.percent / 100;
                    border-radius: 1.5px;
                    background: #0078D4;
                }
            }
        }

        TouchArea {
            moved => {
                if (self.pressed) {
                    root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
    }
}
